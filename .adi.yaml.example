# Copy to .adi.yaml and adjust. All values here are safe defaults.

provider:
  type: anthropic
  api_key_env: ADI_LLM_API_KEY
  model: ${ADI_LLM_MODEL}

runtime:
  type: docker          # docker (default, isolated) | local (opt-in, unsandboxed) | mock (tests)
  image: adi-kali:latest
  allow_local: false

agent:
  max_actions: 150
  max_consecutive_failures: 5

execution:
  concurrent_tools: 2

ui:
  show_reason_summaries: true
  verbose_tool_output: false

# Optional — content-discovery tools (ffuf/feroxbuster) use this before
# falling back to common Kali/Homebrew SecLists/dirb install paths.
# See adi.tools.wordlists.
wordlists:
  web_content: /usr/share/seclists/Discovery/Web-Content/common.txt
