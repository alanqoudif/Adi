# Minimal Kali-based image for Adi's isolated tool-execution runtime.
# Intentionally does not include every Kali package — only the tools Adi
# has skills for (see skills/). Extend as new skills are added.
#
# NOTE: this image is not built or tested in this environment (no Docker
# daemon available here) — verify it builds and runs before relying on it.
# Official multi-platform manifest verified 2026-10-02 (Docker Hub).
FROM kalilinux/kali-rolling@sha256:d1d7e581ed60b0bbf9cb8a4bc853526355978f3b943d3a1d7dc7ce209e4231b6

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    nmap \
    whatweb \
    ffuf \
    feroxbuster \
    hydra \
    medusa \
    enum4linux-ng \
    dnsutils \
    openssh-client \
    gitleaks \
    tcpdump \
    tshark \
    openssl \
    smbclient \
    ldap-utils \
    && rm -rf /var/lib/apt/lists/*

# Non-root user: the runtime also drops all capabilities and sets
# no-new-privileges at container-start time (see adi.runtime.docker_runtime).
RUN useradd -m -u 1000 adi
USER adi
WORKDIR /workspace

ENTRYPOINT []
