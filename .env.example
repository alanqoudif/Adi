# LLM provider (required from Phase 2 onward for autonomous planning;
# Phase 1 tool execution works without it).
KAI_LLM_API_KEY=
KAI_LLM_BASE_URL=
KAI_MODEL=claude-sonnet-5-5

# Example authorized test-account secrets for runtime authentication testing.
# Never commit real values — these are env-var references resolved only at
# execution time (see kai.scope.models.TestAccount and docs/safety-model.md).
KAI_TEST_A_PASSWORD=
KAI_TEST_B_PASSWORD=
KAI_TEST_ADMIN_PASSWORD=
